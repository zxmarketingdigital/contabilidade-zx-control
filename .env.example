# Nome do escritório contábil (usado na instalação guiada p/ personalizar o painel)
ESCRITORIO_NOME=

# Supabase (Auth multi-usuário + RLS) — uma instalação = um escritório.
# A AUTH fail-closed do Worker é o JWT do Supabase (ver src/auth.ts): token
# ausente/vazio/inválido → 401. Não há "segredo de webhook" separado na v1.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# IA — Gemini Flash é o default da linha (provider trocável pelo aluno, "um valor, um lugar")
GEMINI_API_KEY=

# --- RESERVADO v1.1 (notificação de prazo fiscal) — NÃO usado na v1 ---
# A engine de disparo anti-ban (src/scheduler + src/adapters/whatsapp) vem congelada na casca,
# mas o produto v1 NÃO dispara mensagens. Estas vars só passam a valer quando a notificação de
# prazo for adicionada (ver spec §7, §10). Mantenha comentadas na v1.
# WHATSAPP_PROVIDER=evolution        # evolution | zapi | meta | uazapi
# EVOLUTION_URL=
# EVOLUTION_INSTANCE=
# EVOLUTION_API_KEY=
